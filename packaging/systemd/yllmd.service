[Unit]
Description=yllmd local LLM broker
Documentation=file:/usr/local/share/doc/yllmd/README.md
After=local-fs.target

[Service]
Type=simple
User=yllmd
Group=yllm
RuntimeDirectory=yllmd
RuntimeDirectoryMode=0750
StateDirectory=yllmd
StateDirectoryMode=0750
LogsDirectory=yllmd
LogsDirectoryMode=0750
ExecStart=/usr/local/sbin/yllmd -config /usr/local/etc/yllmd/config.yaml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/yllmd /var/run/yllmd /var/log/yllmd

[Install]
WantedBy=multi-user.target
